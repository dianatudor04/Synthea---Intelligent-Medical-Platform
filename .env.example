# ─────────────────────────────────────────────────────────────────────────────
#  Secrets consumed by docker-compose.yml (the `full` profile: backend/worker/
#  frontend). Copy to .env and adjust:  cp .env.example .env
#
#  The infra-only services (postgres/redis/rustfs/mailpit) work without this
#  file. For host dev servers, configure backend/.env instead (see
#  backend/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# ─── JWT (required — compose has no defaults for these) ──────────────
JWT_SECRET=local-dev-jwt-secret-change-me-min-32-characters-long-000
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-min-32-characters-000

# ─── Optional third-party keys (leave blank to disable those features) ─
# OpenAI (doctor-side decision support stub + embeddings)
OPENAI_API_KEY=
# OpenRouter (patient chatbot). Without a key the chatbot errors gracefully.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Synthea Medical Platform
# Stripe (billing stub)
STRIPE_SECRET_KEY=

# ─── Frontend (Vite) build-time API URL ──────────────────────────────
# Baked into the static bundle; must be reachable from the browser.
VITE_API_URL=http://localhost:5000/api

# ─── RustFS object storage (defaults match docker-compose) ───────────
RUSTFS_ACCESS_KEY=synthea_rustfs_access
RUSTFS_SECRET_KEY=synthea_rustfs_secret
RUSTFS_BUCKET=synthea-patient-uploads
RUSTFS_REGION=us-east-1
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
MAX_FILE_SIZE_MB=1024

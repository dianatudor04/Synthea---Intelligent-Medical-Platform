# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL="postgresql://synthea_user:synthea_pass@localhost:5432/synthea_db"

# ─── JWT Authentication ───────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend URL (CORS) ──────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── AI Services ─────────────────────────────────────────
# OpenAI API (currently unused — kept for the doctor-side decision support stub)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# OpenRouter — used by the patient chatbot. Cheap default model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Synthea Medical Platform

# ─── Payment (Stripe) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# ─── File Storage ────────────────────────────────────────
# Legacy upload dir (used by older OCR flow only)
UPLOAD_DIR=uploads
# Max per-file upload size (MB). Personal Uploads supports large medical files.
MAX_FILE_SIZE_MB=1024

# ─── RustFS (S3-compatible object storage) ──────────────
# Internal endpoint reachable from the backend container
RUSTFS_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint used to sign download URLs (default: same as RUSTFS_ENDPOINT)
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=synthea_rustfs_access
RUSTFS_SECRET_KEY=synthea_rustfs_secret
RUSTFS_BUCKET=synthea-patient-uploads
RUSTFS_REGION=us-east-1
PRESIGNED_URL_TTL_SECONDS=300

# ─── OCR Service ─────────────────────────────────────────
# Option A: Local Tesseract.js (no key needed)
OCR_PROVIDER=tesseract
# Option B: Google Cloud Vision
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_KEY_FILE=path/to/service-account.json
# Option C: Azure Computer Vision
# AZURE_VISION_KEY=your-azure-key
# AZURE_VISION_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info

# ─── Redis (BullMQ job queue) ────────────────────────────
# Required for the async worker. Without it the queue degrades to a no-op.
REDIS_URL=redis://localhost:6379

# ─── Embeddings (OpenAI) ─────────────────────────────────
EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Email (Nodemailer → Mailpit in dev) ─────────────────
# Mailpit SMTP on 1025, web UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Synthea <no-reply@synthea.local>
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
EMAIL_MARKETING_ENABLED=true

// ─────────────────────────────────────────────
//  Prisma Schema — Synthea Medical Platform
// ─────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  NURSE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum TriageLevel {
  CRITICAL
  URGENT
  SEMI_URGENT
  NON_URGENT
  ROUTINE
}

enum RecommendationStatus {
  PENDING
  DELIVERED
  DISMISSED
}

enum DeliveryChannel {
  BALLOON
  EMAIL
}

// ─────────────────────────────────────────────
//  User
//  Single auth table for all humans in the system.
//  Role determines which profile exists alongside it.
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1-to-1: only exists when role = PATIENT
  patientProfile         PatientProfile?

  // 1-to-1: only exists when role = DOCTOR
  doctorProfile          DoctorProfile?

  // 1-to-many: doctor side of appointments
  appointmentsAsDoctor   Appointment[]    @relation("DoctorAppointments")

  // 1-to-many: doctor authors medical records
  medicalRecordsAuthored MedicalRecord[]  @relation("DoctorRecords")

  // 1-to-many: doctor reviews triage assessments
  triageReviews          TriageRecord[]   @relation("DoctorTriageReviews")

  // 1-to-many: any user can chat with the assistant
  aiChatSessions         AiChatSession[]

  // 1-to-many: every action logged for GDPR
  auditLogs              AuditLog[]

  // 1-to-1: GDPR consent flags (analytics / profiling / marketing)
  consent                UserConsent?

  // 1-to-many: append-only history of consent changes
  consentAudits          ConsentAudit[]

  // 1-to-many: append-only activity/analytics events (gated on analytics consent)
  activityEvents         ActivityEvent[]

  // 1-to-many: extracted health-interest signals (gated on profiling consent)
  signals                UserSignal[]

  // 1-to-many: generated/delivered content recommendations
  recommendations        Recommendation[]

  @@map("users")
}

// ─────────────────────────────────────────────
//  UserConsent
//  Per-user GDPR consent flags. Each flag gates a different capability:
//   - analytics:      activity/event ingestion
//   - profiling:      embedding + signal extraction (special-category data)
//   - marketingEmail: marketing/digest email (separate opt-in, must be revocable)
//  Defaults are FALSE — nothing personalization-related runs without opt-in.
// ─────────────────────────────────────────────

model UserConsent {
  id             String   @id @default(uuid())
  userId         String   @unique
  analytics      Boolean  @default(false)
  profiling      Boolean  @default(false)
  marketingEmail Boolean  @default(false)
  version        Int      @default(1)        // consent text version in force when set
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

// ─────────────────────────────────────────────
//  ConsentAudit — append-only provenance of every consent change.
//  Answers "when did this user grant/revoke X, and from where".
// ─────────────────────────────────────────────

model ConsentAudit {
  id        String   @id @default(uuid())
  userId    String
  flag      String                            // "analytics" | "profiling" | "marketingEmail"
  value     Boolean
  ipAddress String?
  at        DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consent_audits")
}

// ─────────────────────────────────────────────
//  ActivityEvent — append-only stream of user activity (route changes,
//  blog interactions, chat messages). Writes are fast and dumb; all
//  derivation happens later in workers, not in the request.
//  Gated on the `analytics` consent flag. If volume grows, time-partition
//  this table by createdAt.
// ─────────────────────────────────────────────

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String                            // e.g. "route_change", "blog_open", "chat_message"
  payload   Json?                             // type-specific detail (path, postId, depth, …)
  sessionId String?                           // client-generated session grouping
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("activity_events")
}

// ─────────────────────────────────────────────
//  PatientProfile
//  Medical identity for role=PATIENT users.
// ─────────────────────────────────────────────

model PatientProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  dateOfBirth      DateTime
  gender           Gender
  bloodType        String?
  allergies        String[] @default([])
  cnp              String?  @unique         // Romanian national ID
  insuranceNo      String?
  emergencyContact String?
  address          String?
  city             String?
  country          String   @default("Romania")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  invoices         Invoice[]
  ocrDocuments     OcrDocument[]
  triageRecords    TriageRecord[]
  reviews          Review[]
  documentChunks   DocumentChunk[]

  @@map("patient_profiles")
}

// ─────────────────────────────────────────────
//  DoctorProfile
//  Public-facing profile for role=DOCTOR users.
//  Patients browse this to choose who they book with.
// ─────────────────────────────────────────────

model DoctorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  specialty           String                        // e.g. "Cardiologie", "Dermatologie"
  bio                 String?                       // free-text shown on profile page
  yearsOfExperience   Int?
  consultationFee     Float
  currency            String   @default("RON")
  avgRating           Float?                        // recomputed after every new Review
  totalReviews        Int      @default(0)
  languages           String[] @default(["RO"])     // languages the doctor speaks
  clinicAddress       String?
  acceptsNewPatients  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // reviews received from patients
  reviews             Review[]

  @@map("doctor_profiles")
}

// ─────────────────────────────────────────────
//  Appointment
//  Scheduled meeting between one patient and one doctor.
//  feeAtBooking snapshots the doctor's fee at booking time.
// ─────────────────────────────────────────────

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  doctorId      String
  serviceId     String?
  scheduledAt   DateTime
  duration      Int               @default(30)      // minutes
  status        AppointmentStatus @default(PENDING)
  reason        String?
  notes         String?
  roomNumber    String?
  feeAtBooking  Float?                              // snapshot of fee at booking time (final, post-discount)
  originalFee   Float?                              // pre-discount fee, when a discount was applied
  discountPct   Int?                                // discount percent applied (e.g. 20)
  discountReason String?                            // e.g. "GAP_FILL" — why the discount was given
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  patient       PatientProfile    @relation(fields: [patientId], references: [id])
  doctor        User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  service       MedicalService?   @relation(fields: [serviceId], references: [id])

  // 1-to-1 optional: produced after appointment completes
  medicalRecord MedicalRecord?

  // 1-to-1 optional: patient can leave one review per appointment
  review        Review?

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}

// ─────────────────────────────────────────────
//  MedicalService
//  A bookable service offered for a given specialty
//  (e.g. "Consultație inițială", "ECG", "Telemedicină").
// ─────────────────────────────────────────────

model MedicalService {
  id          String   @id @default(uuid())
  specialty   String                       // matches DoctorProfile.specialty
  name        String
  description String?
  durationMin Int      @default(30)
  basePrice   Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@index([specialty])
  @@index([active])
  @@map("medical_services")
}

// ─────────────────────────────────────────────
//  Review
//  A patient rates a doctor after a completed appointment.
//  One review per appointment (@unique on appointmentId).
// ─────────────────────────────────────────────

model Review {
  id            String         @id @default(uuid())
  patientId     String
  doctorId      String
  appointmentId String         @unique              // one review per visit
  rating        Int                                 // 1–5
  comment       String?
  createdAt     DateTime       @default(now())

  patient       PatientProfile @relation(fields: [patientId], references: [id])
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id])
  appointment   Appointment    @relation(fields: [appointmentId], references: [id])

  @@index([doctorId])
  @@index([patientId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
//  MedicalRecord
//  Clinical note authored by a doctor for a patient.
//  Optionally linked to the appointment that triggered it.
// ─────────────────────────────────────────────

model MedicalRecord {
  id             String         @id @default(uuid())
  patientId      String
  doctorId       String
  appointmentId  String?        @unique             // nullable — can exist without appointment
  diagnosis      String?
  symptoms       String[]       @default([])
  treatment      String?
  prescription   String?
  labResults     Json?
  notes          String?
  isConfidential Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient        PatientProfile @relation(fields: [patientId], references: [id])
  doctor         User           @relation("DoctorRecords", fields: [doctorId], references: [id])
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("medical_records")
}

// ─────────────────────────────────────────────
//  Invoice
// ─────────────────────────────────────────────

model Invoice {
  id              String         @id @default(uuid())
  patientId       String
  amount          Float
  currency        String         @default("RON")
  status          InvoiceStatus  @default(DRAFT)
  lineItems       Json                             // [{ description, quantity, unitPrice }]
  dueDate         DateTime?
  paidAt          DateTime?
  stripePaymentId String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  patient         PatientProfile @relation(fields: [patientId], references: [id])

  @@index([status])
  @@index([patientId])
  @@map("invoices")
}

// ─────────────────────────────────────────────
//  OcrDocument
// ─────────────────────────────────────────────

model OcrDocument {
  id             String         @id @default(uuid())
  patientId      String
  fileUrl        String?                                  // legacy public URL; nullable for new RustFS-backed records
  extractedText  String?
  structuredData Json?
  confidence     Float?
  processed      Boolean        @default(false)
  processedAt    DateTime?
  createdAt      DateTime       @default(now())

  // RustFS-backed upload fields
  fileName       String?                                  // original filename for display
  storageKey     String?                                  // S3 object key inside RUSTFS_BUCKET
  mimeType       String?
  sizeBytes      BigInt?                                  // 1GB > Int32, use BigInt
  category       String?                                  // optional: "lab" | "imaging" | "prescription" | "other"
  source         String         @default("OCR")           // "OCR" (legacy) or "PATIENT_UPLOAD"

  patient        PatientProfile @relation(fields: [patientId], references: [id])

  // Embedding chunks derived from extractedText (gated on profiling consent)
  chunks         DocumentChunk[]

  // Health-interest signals derived from this document (cascade-deleted with it)
  signals        UserSignal[]

  @@index([patientId])
  @@index([source])
  @@map("ocr_documents")
}

// ─────────────────────────────────────────────
//  DocumentChunk — chunked + embedded slices of an OcrDocument's extracted
//  text. Vectors live in pgvector (1536-dim, OpenAI text-embedding-3-small)
//  and are written/queried via raw SQL (Prisma can't yet bind the vector type).
//  This store doubles as the chatbot's retrieval layer.
//  HNSW cosine index is added in the migration (not expressible in Prisma).
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
//  UserSignal — structured health-interest tags extracted by the LLM from a
//  patient's documents (e.g. { tag: "lower_back_pain", confidence: 0.8 }).
//  Special-category processing → gated on profiling consent.
//  Deliberately SEPARATE from clinical records (no FK to MedicalRecord): this
//  is personalization data, not a clinical fact. `source`/`basis`/`sourceDocId`
//  capture provenance so we can later answer "why am I seeing this".
// ─────────────────────────────────────────────

model UserSignal {
  id          String   @id @default(uuid())
  userId      String
  tag         String                            // canonical snake_case topic
  confidence  Float                             // 0..1
  source      String                            // e.g. "document"
  basis       String?                           // short human-readable justification
  sourceDocId String?                           // OcrDocument.id the signal came from
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Right-to-erasure: deleting the source document removes its derived signals.
  sourceDoc   OcrDocument? @relation(fields: [sourceDocId], references: [id], onDelete: Cascade)

  @@index([userId, tag])
  @@index([sourceDocId])
  @@map("user_signals")
}

// ─────────────────────────────────────────────
//  Recommendation pools — hand-authored, editorially-controlled content keyed
//  by signal tag. A user with a signal `tag` above threshold is eligible for
//  the pool with that tag. Matching is a simple, explainable rule (no ML).
// ─────────────────────────────────────────────

model Pool {
  id          String   @id @default(uuid())
  tag         String   @unique                  // matches UserSignal.tag
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PoolItem[]

  @@map("pools")
}

model PoolItem {
  id         String   @id @default(uuid())
  poolId     String
  adviceText String                              // curated, clinician-endorsed copy
  ctaLabel   String?                             // call-to-action button text
  ctaUrl     String?                             // where the CTA points
  serviceId  String?                             // optional link to a MedicalService
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pool            Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([poolId])
  @@map("pool_items")
}

// ─────────────────────────────────────────────
//  Recommendation — generated ahead of time by a job, then read by the
//  delivery channels (balloon / email). Status tracks the lifecycle and the
//  table doubles as the delivery log used for dedupe + frequency-capping.
//  signalTag/signalBasis answer "why am I seeing this".
// ─────────────────────────────────────────────

model Recommendation {
  id          String               @id @default(uuid())
  userId      String
  poolItemId  String
  status      RecommendationStatus @default(PENDING)
  channel     DeliveryChannel?                    // set when delivered
  signalTag   String                              // the signal that triggered it
  signalBasis String?                             // provenance for "why"
  createdAt   DateTime             @default(now())
  deliveredAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolItem    PoolItem @relation(fields: [poolItemId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, deliveredAt])
  @@map("recommendations")
}

model DocumentChunk {
  id         String                       @id @default(uuid())
  documentId String
  patientId  String
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  document   OcrDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([patientId])
  @@map("document_chunks")
}

// ─────────────────────────────────────────────
//  TriageRecord
// ─────────────────────────────────────────────

model TriageRecord {
  id                   String         @id @default(uuid())
  patientId            String
  reviewedByDoctorId   String?
  symptoms             String[]
  triageLevel          TriageLevel
  recommendedSpecialty String?
  aiConfidence         Float?
  createdAt            DateTime       @default(now())

  patient              PatientProfile @relation(fields: [patientId], references: [id])
  reviewedByDoctor     User?          @relation("DoctorTriageReviews", fields: [reviewedByDoctorId], references: [id])

  @@map("triage_records")
}

// ─────────────────────────────────────────────
//  AiChatSession
// ─────────────────────────────────────────────

model AiChatSession {
  id             String   @id @default(uuid())
  userId         String
  messages       Json                             // [{ role, content, timestamp }]
  medicalContext Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])

  @@map("ai_chat_sessions")
}

// ─────────────────────────────────────────────
//  AuditLog — append only, never updated
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String                               // e.g. "READ_PATIENT", "UPDATE_RECORD"
  resource   String                               // e.g. "MedicalRecord"
  resourceId String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
//  Drug interactions (DDInter dataset)
// ─────────────────────────────────────────────

// Master list of known drugs — used for medication autocomplete.
model Drug {
  name String @id                                   // canonical display name from DDInter
  key  String @unique                               // lowercased name, used for matching

  @@index([key])
  @@map("drugs")
}

// Pairwise drug-drug interactions. Keys are lowercased and canonically
// ordered (keyA <= keyB) so a pair can be looked up regardless of input order.
model DrugInteraction {
  id    Int    @id @default(autoincrement())
  keyA  String                                      // lowercased drug name, keyA <= keyB
  keyB  String
  drugA String                                      // original display name
  drugB String
  level String                                      // Major | Moderate | Minor | Unknown

  @@unique([keyA, keyB])
  @@index([keyA])
  @@index([keyB])
  @@map("drug_interactions")
}
